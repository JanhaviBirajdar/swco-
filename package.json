{
  "name": "vasuniti-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,cyan\" \"npm run server\" \"npm run client\"",
    "client": "npm --prefix client run dev",
    "server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "client:install": "npm --prefix client install",
    "server:install": "npm --prefix server install",
    "install:all": "npm run server:install && npm run client:install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
